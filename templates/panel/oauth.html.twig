<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Connect Mania to ChatGPT</title><link rel="stylesheet" href="/assets/panel.css"></head>
<body class="bg-slate-50 text-slate-900"><main class="mx-auto max-w-xl p-6"><h1 class="text-2xl font-semibold">Connect Mania to ChatGPT</h1><p class="my-4">Sign in as the configuration owner to authorize this connection.</p><ul>{% for scope in scopes %}<li>{{ scope == 'configuration:write' ? 'Save and restore configuration after your confirmation in ChatGPT.' : 'Read configuration, preferences, guidance and version history; preview responses to supplied inquiries using OpenAI.' }}</li>{% endfor %}</ul>{% if error %}<p role="alert" class="my-4 text-red-700">{{ error }}</p>{% endif %}<form method="post" class="my-6"><input type="hidden" name="_token" value="{{ token }}"><label for="password" class="block">Owner password</label><input id="password" name="password" type="password" autocomplete="current-password" required class="my-2 w-full rounded border p-2"><button name="decision" value="approve" class="rounded bg-slate-900 px-4 py-2 text-white">Authorize ChatGPT</button><button name="decision" value="deny" formnovalidate class="px-4 py-2">Cancel</button></form></main></body></html>
