{% extends 'panel/base.html.twig' %}
{% block title %}{{ 'Sign in'|trans }}{% endblock %}
{% block body %}
<div class="mx-auto max-w-md rounded-2xl border border-stone-200 bg-white p-8 shadow-sm"><p class="eyebrow">{{ 'Owner access'|trans }}</p><h1>{{ 'Sign in'|trans }}</h1><p class="mt-3 text-sm leading-6 text-slate-600">{{ 'Use your owner password to manage company configuration.'|trans }}</p>
{% if error %}<p role="alert" class="notice mt-5 border-red-200 bg-red-50 text-red-900">{{ 'Sign-in failed. Check your password or try again later.'|trans }}</p>{% endif %}
<form method="post" action="{{ path('owner_login') }}" class="mt-6"><input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}"><label for="password" class="block text-sm font-semibold">{{ 'Owner password'|trans }}</label><input id="password" name="password" type="password" required autocomplete="current-password" class="mt-2 mb-6 block w-full rounded-lg border border-stone-300 p-3"><button class="button w-full">{{ 'Sign in'|trans }}</button></form>
</div>
{% endblock %}
