{
  "name": "office/email-assistant",
  "description": "Self-hosted approved-content email drafts and company configuration",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.4",
    "ext-dom": "*",
    "ext-mbstring": "*",
    "ext-pdo_sqlite": "*",
    "doctrine/doctrine-bundle": "^2.18",
    "doctrine/doctrine-migrations-bundle": "^3.7",
    "doctrine/orm": "^3.6",
    "egulias/email-validator": "^4.0",
    "league/commonmark": "^2.7",
    "league/oauth2-server": "^9.4",
    "nyholm/psr7": "^1.8",
    "symfony/ai-open-ai-platform": "^0.13.0",
    "symfony/console": "7.4.*",
    "symfony/dotenv": "7.4.*",
    "symfony/framework-bundle": "7.4.*",
    "symfony/http-client": "7.4.*",
    "symfony/lock": "7.4.*",
    "symfony/mailer": "7.4.*",
    "symfony/mcp-bundle": "^0.14.1",
    "symfony/mime": "7.4.*",
    "symfony/property-info": "7.4.*",
    "symfony/psr-http-message-bridge": "7.4.*",
    "symfony/security-bundle": "7.4.*",
    "symfony/security-csrf": "7.4.*",
    "symfony/serializer": "7.4.*",
    "symfony/translation": "7.4.*",
    "symfony/twig-bundle": "7.4.*",
    "symfony/yaml": "7.4.*",
    "webklex/php-imap": "^6.2"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5",
    "symfony/browser-kit": "7.4.*",
    "symfony/css-selector": "7.4.*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.4.0"
    },
    "allow-plugins": false
  },
  "scripts": {
    "test": "phpunit",
    "check": [
      "@test",
      "@php bin/console lint:container",
      "@php bin/console lint:twig templates",
      "@php bin/console lint:yaml config examples translations"
    ],
    "analyse": "phpstan analyse --no-progress",
    "cs:check": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix"
  }
}
